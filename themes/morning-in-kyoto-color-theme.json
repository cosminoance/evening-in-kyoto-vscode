    "breadcrumb.activeSelectionForeground": "#9c7e00",
    "breadcrumbPicker.background": "#f6f6ef",
    "titleBar.activeBackground": "#f6f6ef",
    "titleBar.activeForeground": "#1a1a1a",
    "titleBar.inactiveBackground": "#f6f6ef",
    "titleBar.inactiveForeground": "#625e4c",
    "activityBar.background": "#f6f6ef",
    "activityBar.foreground": "#1a1a1a",
    "activityBar.inactiveForeground": "#625e4c",
    "activityBar.activeBorder": "#9c7e00",
    "activityBar.border": "#f6f6ef",
    "activityBarBadge.background": "#9c7e00",
    "activityBarBadge.foreground": "#f6f6ef",
    "badge.background": "#9c7e00",
    "badge.foreground": "#f6f6ef",
    "sideBar.background": "#f6f6ef",
    "sideBar.foreground": "#1a1a1a",
    "sideBar.border": "#f6f6ef",
    "sideBarTitle.foreground": "#9c7e00",
    "sideBarSectionHeader.background": "#f6f6ef",
    "sideBarSectionHeader.foreground": "#1a1a1a",
    "sideBarSectionHeader.border": "#dcdbcc",
    "panel.background": "#f6f6ef",
    "panel.border": "#dcdbcc",
    "panelTitle.activeForeground": "#9c7e00",
    "panelTitle.activeBorder": "#9c7e00",
    "panelTitle.inactiveForeground": "#625e4c",
    "button.background": "#9c7e00",
    "button.foreground": "#f6f6ef",
    "button.hoverBackground": "#c95c00",
    "button.secondaryBackground": "#dcdbcc",
    "button.secondaryForeground": "#1a1a1a",
    "progressBar.background": "#9c7e00",
    "scrollbarSlider.background": "#625e4c66",
    "scrollbarSlider.hoverBackground": "#625e4c99",
    "scrollbarSlider.activeBackground": "#625e4c",
    "peekView.border": "#9c7e00",
    "peekViewEditor.background": "#f6f6ef",
    "peekViewResult.background": "#f6f6ef",
    "peekViewTitle.background": "#f6f6ef",
    "peekViewEditor.matchHighlightBackground": "#9c7e004d",
    "peekViewResult.matchHighlightBackground": "#9c7e004d",
    "peekViewResult.selectionBackground": "#dcdbcc",
    "debugToolBar.background": "#f6f6ef",
    "gitDecoration.addedResourceForeground": "#84946d",
    "gitDecoration.modifiedResourceForeground": "#c95c00",
    "gitDecoration.deletedResourceForeground": "#9f7887",
    "gitDecoration.untrackedResourceForeground": "#246876",
    "gitDecoration.ignoredResourceForeground": "#625e4c",
    "gitDecoration.conflictingResourceForeground": "#9e7cc0",
    "editorGutter.addedBackground": "#84946d",
    "editorGutter.modifiedBackground": "#c95c00",
    "editorGutter.deletedBackground": "#9f7887",
    "diffEditor.insertedTextBackground": "#84946d33",
    "diffEditor.removedTextBackground": "#9f788733",
    "diffEditor.insertedLineBackground": "#84946d1a",
    "diffEditor.removedLineBackground": "#9f78871a",
    "terminal.background": "#f6f6ef",
    "terminal.foreground": "#1a1a1a",
    "terminalCursor.foreground": "#1a1a1a",
    "terminal.selectionBackground": "#dcdbcc",
    "terminal.ansiBlack": "#1a1a1a",
    "terminal.ansiRed": "#9f7887",
    "terminal.ansiGreen": "#84946d",
    "terminal.ansiYellow": "#c95c00",
    "terminal.ansiBlue": "#4c8ce6",
    "terminal.ansiMagenta": "#9e7cc0",
    "terminal.ansiCyan": "#246876",
    "terminal.ansiWhite": "#c4c5b5",
    "terminal.ansiBrightBlack": "#625e4c",
    "terminal.ansiBrightRed": "#9f7887",
    "terminal.ansiBrightGreen": "#84946d",
    "terminal.ansiBrightYellow": "#9c7e00",
    "terminal.ansiBrightBlue": "#4c8ce6",
    "terminal.ansiBrightMagenta": "#9e7cc0",
    "terminal.ansiBrightCyan": "#246876",
    "terminal.ansiBrightWhite": "#f6f6ef"
