  "tokenColors": [
    {
      "name": "Delimiter, @punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#1a1a1a"
      }
    },
    {
      "name": "Identifier, @variable, @property",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#1a1a1a",
        "fontStyle": ""
      }
    },
    {
      "name": "@variable.parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#1a1a1a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "@variable.builtin",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#9f7887",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#625e4c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.regexp",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9c7e00"
      }
    },
    {
      "name": "@string.escape, @string.special",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#4c8ce6"
      }
    },
    {
      "name": "@punctuation.special",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#4c8ce6"
      }
    },
    {
      "name": "Constant, Number, Character",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.character",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#9e7cc0",
        "fontStyle": ""
      }
    },
    {
      "name": "@constant.builtin",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#9e7cc0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Boolean",
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#9e7cc0",
        "fontStyle": ""
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call.generic",
        "entity.name.function.macro",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#84946d",
        "fontStyle": ""
      }
    },
    {
      "name": "@function.builtin",
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#84946d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9f7887",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Conditional, Repeat, Exception",
      "scope": [
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.exception",
        "keyword.control.switch"
      ],
      "settings": {
        "foreground": "#9f7887",
        "fontStyle": ""
      }
    },
    {
      "name": "Include, Define, Macro",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.directive",
        "keyword.other.import",
        "keyword.other.use",
        "meta.preprocessor punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#9f7887",
        "fontStyle": ""
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor.optional",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#9f7887",
        "fontStyle": ""
      }
    },
    {
      "name": "PreProc",
      "scope": [
        "meta.preprocessor",
        "meta.preprocessor.string"
      ],
      "settings": {
        "foreground": "#9c7e00"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "entity.name.type.interface",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.numeric.go",
        "storage.type.string.go",
        "storage.type.java",
        "storage.type.cs"
      ],
      "settings": {
        "foreground": "#246876",
        "fontStyle": "italic"
      }
    },
    {
      "name": "@module, @constructor",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.type.module",
        "entity.name.type.namespace",
        "entity.name.function.constructor",
        "new.expr entity.name.type"
      ],
      "settings": {
        "foreground": "#246876",
        "fontStyle": ""
      }
    },
    {
      "name": "@property, overriding Type for keys",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#1a1a1a",
        "fontStyle": ""
      }
    },
    {
      "name": "@attribute",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "meta.attribute",
        "storage.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#c95c00",
        "fontStyle": "italic"
      }
    },
    {
      "name": "@tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#9f7887",
        "fontStyle": ""
      }
    },
    {
      "name": "@tag.attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#c95c00",
        "fontStyle": "italic"
      }
    },
    {
      "name": "@tag.delimiter",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#625e4c"
      }
    },
    {
      "name": "@markup.heading",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#9c7e00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "@markup.strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "@markup.italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "@markup.strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "@markup.link",
      "scope": [
        "string.other.link",
        "markup.underline.link.image"
      ],
      "settings": {
        "foreground": "#4c8ce6",
        "fontStyle": "underline"
      }
    },
    {
      "name": "@markup.link.url",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#246876",
        "fontStyle": "underline"
      }
    },
    {
      "name": "@markup.raw",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#84946d",
        "fontStyle": ""
      }
    },
    {
      "name": "@markup.list",
      "scope": [
        "punctuation.definition.list.begin",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#9f7887"
      }
    },
    {
      "name": "@markup.quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#625e4c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "@diff.plus",
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#84946d"
      }
    },
    {
      "name": "@diff.minus",
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#9f7887"
      }
    },
    {
      "name": "@diff.delta",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#c95c00"
      }
    },
    {
      "name": "Error",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#9f7887",
        "fontStyle": "bold"
      }
    },
    {
      "name": "@lsp.mod.deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "class": {
      "foreground": "#246876",
      "italic": true
    },
    "class.defaultLibrary": {
      "foreground": "#246876",
      "italic": true
    },
    "decorator": {
      "foreground": "#c95c00",
      "italic": true
    },
    "enum": {
      "foreground": "#246876",
      "italic": true
    },
    "enumMember": "#9e7cc0",
    "function": "#84946d",
    "function.defaultLibrary": {
      "foreground": "#84946d",
      "italic": true
    },
    "interface": {
      "foreground": "#246876",
      "italic": true
    },
    "macro": "#84946d",
    "method": "#84946d",
    "namespace": "#246876",
    "parameter": {
      "foreground": "#1a1a1a",
      "italic": true
    },
    "property": "#1a1a1a",
    "struct": {
      "foreground": "#246876",
      "italic": true
    },
    "type": {
      "foreground": "#246876",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#246876",
      "italic": true
    },
    "variable": "#1a1a1a",
    "variable.readonly": "#9e7cc0",
    "variable.defaultLibrary": {
      "foreground": "#9f7887",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
